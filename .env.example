# Copy to .env and fill in real secrets. Never commit .env.

ENVIRONMENT=development
API_KEY=dev-local-key
LOG_LEVEL=INFO

# --- Generation ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the active embedding model's output dimension.
EMBEDDING_DIM=1024

# --- Cache store (CAG) ---
REDIS_URL=redis://localhost:6379/0
CACHE_KEY_PREFIX=cag:cached_context
CACHE_KEY_VERSION=v1
COLD_SOURCE_DIR=data/cold_sources
CACHED_CONTEXT_MAX_TOKENS=6000

# --- Vector store (RAG) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents
TOP_K=4

# --- Chunking (hot ingestion) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
