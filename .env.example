# Copy to .env and fill in real secrets. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth ---
# Legacy single key, mapped to client_id "default". Change this.
API_KEY=dev-local-key
# Additional callers, each with their own rate limit / budget tracking:
# "key1:alice,key2:bob". Leave blank if API_KEY is all you need.
API_KEYS=

# --- Rate limiting & budget guardrails (per API key / client_id) ---
RATE_LIMIT_PER_MINUTE=60
# 0 = no cap. Set this if you're handing a key to someone else.
MAX_DAILY_TOKENS_PER_CLIENT=0

# --- Generation ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the active embedding model's output dimension.
EMBEDDING_DIM=1024
# Probe the embedding provider once at startup and fail fast if EMBEDDING_DIM
# is wrong, instead of a confusing Qdrant error later. Costs one API call.
VALIDATE_EMBEDDING_DIM=true

# --- Cache store (CAG) ---
REDIS_URL=redis://localhost:6379/0
CACHE_KEY_PREFIX=cag:cached_context
CACHE_KEY_VERSION=v1
COLD_SOURCE_DIR=data/cold_sources
CACHED_CONTEXT_MAX_TOKENS=6000

# --- Vector store (RAG) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents
TOP_K=4

# --- Chunking (hot ingestion) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
